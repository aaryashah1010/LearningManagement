ENV=development
PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=learning_management

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_AUTH_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Gemini's free-tier OpenAI-compatible API — get a key at aistudio.google.com/apikey.
# (NVIDIA's build.nvidia.com is also free and OpenAI-compatible — swap LLM_PROVIDER/
# LLM_MODEL/LLM_BASE_URL to use it instead, no code changes needed either way.)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

BUBBLE_DETECTION_PROVIDER=opencv
QUESTION_PAPER_PARSER_PROVIDER=text_layer

# Cloud Vision key for handwriting OCR (the submission header's NAME field) —
# get one at console.cloud.google.com after enabling the Cloud Vision API.
OCR_PROVIDER=google_vision
VISION_API_KEY=

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
